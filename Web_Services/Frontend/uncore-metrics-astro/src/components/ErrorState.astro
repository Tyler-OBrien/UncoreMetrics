---
/** Shown in place of content when an API call fails. */
interface Props {
	title?: string;
	message: string;
}
const { title = "Something went wrong", message } = Astro.props;
---
<div class="surface p-6 stack gap-2" role="alert">
	<h2 class="text-lg font-semibold">{title}</h2>
	<p class="muted">{message}</p>
</div>
